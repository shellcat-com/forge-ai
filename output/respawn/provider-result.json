{
  "html": "<!doctype html>\n<html lang=\"en\" dir=\"ltr\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>RESPAWN — Gaming Marketplace</title>\n  <style>\n    /* SYSTEM FONTS AND RESET */\n    * {\n      margin: 0;\n      padding: 0;\n      box-sizing: border-box;\n    }\n\n    body {\n      font-family: Arial, Helvetica, sans-serif;\n      background: #f4f2f7;\n      color: #1d1d1f;\n      line-height: 1.5;\n      transition: background 0.25s ease, color 0.25s ease;\n    }\n\n    body.dark {\n      background: #0c0c10;\n      color: #f2f0eb;\n    }\n\n    /* THEME VARIABLES */\n    :root {\n      --bg: #f4f2f7;\n      --surface: #ffffff;\n      --surface-2: #f7f6f9;\n      --card: #ffffff;\n      --text: #1d1d1f;\n      --muted: #5f5e6b;\n      --border: #e3e0e8;\n      --accent: #b9a0ff;\n      --accent-2: #ff785b;\n      --accent-dark: #7c5ce0;\n      --shadow: 0 8px 20px rgba(0,0,0,0.04);\n      --hero-bg: #121217;\n      --hero-text: #f2f0eb;\n      --header-bg: rgba(255,255,255,0.85);\n      --header-text: #1d1d1f;\n    }\n\n    body.dark {\n      --bg: #0c0c10;\n      --surface: #17171d;\n      --surface-2: #20202a;\n      --card: #17171d;\n      --text: #f2f0eb;\n      --muted: #a9a6b5;\n      --border: #2a2a35;\n      --accent: #b9a0ff;\n      --accent-2: #ff785b;\n      --accent-dark: #9f86ff;\n      --shadow: 0 14px 28px rgba(0,0,0,0.5);\n      --hero-bg: #101016;\n      --hero-text: #f2f0eb;\n      --header-bg: rgba(12,12,16,0.82);\n      --header-text: #f2f0eb;\n    }\n\n    body {\n      background: var(--bg);\n      color: var(--text);\n    }\n\n    /* ACCESSIBLE BUTTON RESET */\n    button {\n      font-family: inherit;\n      font-size: inherit;\n      cursor: pointer;\n      border: none;\n      background: none;\n      color: inherit;\n      touch-action: manipulation;\n    }\n\n    button:focus-visible, a:focus-visible, input:focus-visible, select:focus-visible {\n      outline: 3px solid #b9a0ff;\n      outline-offset: 3px;\n      border-radius: 6px;\n    }\n\n    a {\n      color: inherit;\n      text-decoration: none;\n    }\n\n    /* LAYOUT */\n    .container {\n      width: 100%;\n      max-width: 1440px;\n      margin: 0 auto;\n      padding: 0 24px;\n    }\n\n    /* HEADER */\n    .site-header {\n      background: var(--header-bg);\n      backdrop-filter: blur(12px);\n      position: sticky;\n      top: 0;\n      z-index: 40;\n      border-bottom: 1px solid var(--border);\n      transition: background 0.25s;\n    }\n\n    .header-wrapper {\n      display: flex;\n      align-items: center;\n      flex-wrap: wrap;\n      gap: 18px 24px;\n      padding: 12px 0;\n    }\n\n    .logo-area {\n      display: flex;\n      align-items: center;\n      gap: 10px;\n      font-weight: 1000;\n      font-size: 1.8rem;\n      letter-spacing: -0.02em;\n      color: var(--header-text);\n    }\n\n    .logo-dot {\n      width: 22px;\n      height: 22px;\n      background: var(--accent-2);\n      border-radius: 50%;\n      display: inline-block;\n      box-shadow: 0 0 0 3px rgba(255,120,91,0.25);\n    }\n\n    .main-nav {\n      display: flex;\n      align-items: center;\n      gap: 22px;\n      font-weight: 600;\n      font-size: 0.95rem;\n    }\n\n    .main-nav a {\n      transition: color 0.2s;\n      color: var(--header-text);\n    }\n\n    .main-nav a:hover { color: var(--accent-dark); }\n\n    .search-box {\n      display: flex;\n      align-items: center;\n      background: var(--surface-2);\n      border: 1px solid var(--border);\n      border-radius: 40px;\n      padding: 5px 12px;\n      flex: 1 1 220px;\n      min-width: 180px;\n      height: 44px;\n    }\n\n    .search-box svg {\n      opacity: 0.55;\n      margin-right: 8px;\n      flex-shrink: 0;\n    }\n\n    .search-box input {\n      border: none;\n      background: transparent;\n      width: 100%;\n      font-size: 0.95rem;\n      color: var(--text);\n      outline: none;\n    }\n\n    .search-box input::placeholder { color: var(--muted); }\n\n    .icon-buttons {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      margin-left: auto;\n    }\n\n    .icon-btn {\n      background: transparent;\n      border: 1px solid var(--border);\n      border-radius: 40px;\n      padding: 8px 12px;\n      min-width: 44px;\n      min-height: 44px;\n      display: flex;\n      align-items: center;\n      gap: 6px;\n      font-weight: 600;\n      color: var(--header-text);\n      white-space: nowrap;\n      transition: background 0.2s;\n      font-size: 0.9rem;\n    }\n\n    .icon-btn:hover { background: var(--surface-2); }\n    .icon-btn svg { width: 18px; height: 18px; }\n\n    .status-strip {\n      background: var(--accent-2);\n      color: #0c0c10;\n      font-weight: 700;\n      font-size: 0.75rem;\n      letter-spacing: 1.5px;\n      text-align: center;\n      padding: 6px 10px;\n      display: flex;\n      flex-wrap: wrap;\n      justify-content: center;\n      gap: 20px;\n    }\n\n    /* HERO */\n    .hero-section {\n      background: var(--hero-bg);\n      color: var(--hero-text);\n      border-radius: 24px;\n      margin-top: 18px;\n      overflow: hidden;\n      position: relative;\n      min-height: clamp(380px, 50vw, 600px);\n    }\n\n    .hero-bg {\n      position: absolute;\n      inset: 0;\n      background-image: url('http://127.0.0.1:5173/marketplace/hero.webp');\n      background-size: cover;\n      background-position: right center;\n      background-repeat: no-repeat;\n    }\n\n    .hero-gradient {\n      position: absolute;\n      inset: 0;\n      background: linear-gradient(90deg, rgba(12,12,16,0.95) 0%, rgba(12,12,16,0.75) 45%, rgba(12,12,16,0.0) 70%);\n    }\n\n    .hero-content {\n      position: relative;\n      z-index: 2;\n      padding: 48px 36px;\n      max-width: 700px;\n      display: flex;\n      flex-direction: column;\n      align-items: flex-start;\n      gap: 18px;\n      height: 100%;\n      justify-content: center;\n    }\n\n    .hero-pill {\n      background: rgba(185,160,255,0.12);\n      border: 1px solid #b9a0ff;\n      color: #b9a0ff;\n      font-weight: 700;\n      font-size: 0.75rem;\n      letter-spacing: 1.2px;\n      padding: 6px 14px;\n      border-radius: 40px;\n    }\n\n    .hero-title {\n      font-size: clamp(2.8rem, 7vw, 5.5rem);\n      font-weight: 1000;\n      letter-spacing: -0.04em;\n      line-height: 0.95;\n      max-width: 600px;\n    }\n\n    .hero-desc {\n      font-size: 1.1rem;\n      color: #cfcbd8;\n      max-width: 460px;\n      margin: 0;\n    }\n\n    .hero-cta {\n      background: #b9a0ff;\n      color: #0c0c10;\n      border-radius: 40px;\n      padding: 14px 28px;\n      font-weight: 800;\n      font-size: 1rem;\n      transition: background 0.25s;\n      min-height: 48px;\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      margin-top: 12px;\n    }\n\n    .hero-cta:hover { background: #cfbaff; }\n\n    .hero-small {\n      font-size: 0.85rem;\n      color: #aaa5b8;\n      margin-top: 6px;\n    }\n\n    /* SERVICE STRIP */\n    .service-strip {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 16px;\n      justify-content: center;\n      padding: 28px 0 8px;\n      font-weight: 600;\n      color: var(--muted);\n    }\n\n    .service-strip span {\n      background: var(--surface);\n      padding: 10px 22px;\n      border-radius: 40px;\n      border: 1px solid var(--border);\n      font-size: 0.9rem;\n    }\n\n    /* PRODUCT SECTION */\n    .product-section {\n      margin: 48px 0;\n    }\n\n    .section-head {\n      display: flex;\n      flex-wrap: wrap;\n      align-items: flex-end;\n      justify-content: space-between;\n      gap: 18px;\n      margin-bottom: 28px;\n    }\n\n    .section-head h2 {\n      font-size: 2.6rem;\n      font-weight: 900;\n      letter-spacing: -0.03em;\n    }\n\n    .section-sub {\n      color: var(--muted);\n      max-width: 350px;\n      font-size: 1rem;\n    }\n\n    .filters-row {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 14px;\n      align-items: center;\n      margin-bottom: 28px;\n    }\n\n    .filter-tabs {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 8px;\n    }\n\n    .filter-tab {\n      background: var(--surface);\n      border: 1px solid var(--border);\n      border-radius: 40px;\n      padding: 8px 16px;\n      font-weight: 600;\n      transition: all 0.2s;\n      min-height: 40px;\n      color: var(--text);\n    }\n\n    .filter-tab[aria-pressed=\"true\"] {\n      background: #17171d;\n      color: white;\n      border-color: #17171d;\n    }\n\n    body:not(.dark) .filter-tab[aria-pressed=\"true\"] {\n      background: #1d1d1f;\n      color: #fff;\n    }\n\n    select.sort-select {\n      background: var(--surface);\n      border: 1px solid var(--border);\n      border-radius: 40px;\n      padding: 8px 16px;\n      font-weight: 600;\n      font-size: 0.9rem;\n      color: var(--text);\n      min-height: 42px;\n      margin-left: auto;\n    }\n\n    .product-grid {\n      display: grid;\n      grid-template-columns: repeat(4, 1fr);\n      gap: 28px;\n    }\n\n    .product-card {\n      background: var(--card);\n      border-radius: 18px;\n      overflow: hidden;\n      border: 1px solid var(--border);\n      box-shadow: var(--shadow);\n      transition: transform 0.2s, box-shadow 0.2s;\n      display: flex;\n      flex-direction: column;\n    }\n\n    .product-card:hover {\n      transform: translateY(-4px);\n      box-shadow: 0 18px 32px rgba(0,0,0,0.08);\n    }\n\n    .card-img {\n      height: 200px;\n      background-size: cover;\n      background-position: center;\n      position: relative;\n    }\n\n    .card-tag {\n      position: absolute;\n      top: 12px;\n      left: 12px;\n      background: rgba(12,12,16,0.7);\n      color: white;\n      font-size: 0.7rem;\n      font-weight: 700;\n      padding: 4px 10px;\n      border-radius: 40px;\n      backdrop-filter: blur(4px);\n      letter-spacing: 0.5px;\n    }\n\n    .save-btn {\n      position: absolute;\n      top: 10px;\n      right: 10px;\n      background: rgba(12,12,16,0.55);\n      border-radius: 50%;\n      width: 40px;\n      height: 40px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      color: white;\n      transition: background 0.2s;\n      border: 1px solid rgba(255,255,255,0.2);\n    }\n\n    .save-btn[aria-pressed=\"true\"] svg {\n      fill: #ff785b;\n      stroke: #ff785b;\n    }\n\n    .card-body {\n      padding: 20px 18px;\n      display: flex;\n      flex-direction: column;\n      gap: 8px;\n      flex: 1;\n    }\n\n    .card-category {\n      color: var(--accent-dark);\n      font-weight: 700;\n      font-size: 0.75rem;\n      letter-spacing: 0.8px;\n      text-transform: uppercase;\n    }\n\n    .card-name {\n      font-weight: 800;\n      font-size: 1.3rem;\n      letter-spacing: -0.02em;\n    }\n\n    .card-desc {\n      color: var(--muted);\n      font-size: 0.9rem;\n      flex: 1;\n    }\n\n    .card-price {\n      font-weight: 900;\n      font-size: 1.4rem;\n      margin-top: 6px;\n    }\n\n    .add-btn {\n      background: transparent;\n      border: 1.5px solid var(--text);\n      padding: 12px 18px;\n      border-radius: 40px;\n      font-weight: 800;\n      margin-top: 12px;\n      transition: all 0.2s;\n      color: var(--text);\n      min-height: 46px;\n      width: 100%;\n    }\n\n    .add-btn:hover {\n      background: var(--text);\n      color: var(--bg);\n    }\n\n    body.dark .add-btn { border-color: #f2f0eb; }\n    body.dark .add-btn:hover { background: #f2f0eb; color: #0c0c10; }\n\n    /* EMPTY STATE */\n    .empty-state {\n      text-align: center;\n      padding: 60px 20px;\n      color: var(--muted);\n      background: var(--surface);\n      border-radius: 20px;\n      border: 1px dashed var(--border);\n      grid-column: 1 / -1;\n    }\n\n    .reset-btn {\n      background: var(--accent);\n      color: #0c0c10;\n      border: none;\n      border-radius: 40px;\n      padding: 10px 22px;\n      font-weight: 700;\n      margin-top: 16px;\n    }\n\n    /* EDITORIAL PANEL */\n    .editorial-panel {\n      background: #101016;\n      color: #f2f0eb;\n      border-radius: 28px;\n      padding: 48px 32px;\n      margin: 50px 0;\n      display: flex;\n      flex-wrap: wrap;\n      align-items: center;\n      gap: 40px;\n    }\n\n    .editorial-panel img {\n      max-width: 380px;\n      width: 100%;\n      border-radius: 20px;\n      background: #2b2b33;\n    }\n\n    .editorial-copy h3 {\n      font-size: 2.8rem;\n      font-weight: 900;\n      letter-spacing: -0.04em;\n    }\n\n    .editorial-copy p {\n      color: #bcb8ca;\n      margin: 16px 0;\n    }\n\n    .shop-btn {\n      background: #b9a0ff;\n      color: #0c0c10;\n      border-radius: 40px;\n      padding: 14px 28px;\n      font-weight: 800;\n    }\n\n    /* FOOTER */\n    .site-footer {\n      border-top: 1px solid var(--border);\n      padding: 40px 0;\n      margin-top: 50px;\n      display: flex;\n      flex-wrap: wrap;\n      justify-content: space-between;\n      align-items: center;\n      gap: 20px;\n    }\n\n    .footer-left {\n      font-weight: 900;\n      font-size: 1.8rem;\n      display: flex;\n      align-items: center;\n      gap: 10px;\n    }\n\n    .footer-dot {\n      width: 12px;\n      height: 12px;\n      background: #ff785b;\n      border-radius: 50%;\n    }\n\n    /* CART DIALOG */\n    .dialog-overlay {\n      position: fixed;\n      inset: 0;\n      background: rgba(0,0,0,0.5);\n      z-index: 100;\n      display: flex;\n      justify-content: flex-end;\n      align-items: stretch;\n    }\n\n    .cart-dialog {\n      background: var(--surface);\n      width: min(420px, 100%);\n      padding: 24px;\n      display: flex;\n      flex-direction: column;\n      gap: 16px;\n      border-left: 1px solid var(--border);\n      box-shadow: -10px 0 30px rgba(0,0,0,0.2);\n      overflow-y: auto;\n      border-radius: 18px 0 0 18px;\n    }\n\n    .dialog-header {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n    }\n\n    .cart-item {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      gap: 12px;\n      border-bottom: 1px solid var(--border);\n      padding: 12px 0;\n    }\n\n    .qty-controls {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      margin-top: 4px;\n    }\n\n    .qty-btn {\n      background: var(--surface-2);\n      border-radius: 50%;\n      width: 36px;\n      height: 36px;\n      font-weight: 900;\n    }\n\n    .cart-total {\n      font-weight: 900;\n      font-size: 1.6rem;\n      margin-top: 10px;\n    }\n\n    .checkout-btn, .dialog-main-btn {\n      background: var(--accent);\n      color: #0c0c10;\n      border-radius: 40px;\n      padding: 14px;\n      font-weight: 800;\n      width: 100%;\n    }\n\n    .close-btn {\n      background: transparent;\n      font-size: 2rem;\n      font-weight: 400;\n      width: 44px;\n      height: 44px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n\n    @media (max-width: 1100px) {\n      .product-grid { grid-template-columns: repeat(3, 1fr); }\n    }\n\n    @media (max-width: 768px) {\n      .header-wrapper { flex-wrap: wrap; gap: 12px; }\n      .product-grid { grid-template-columns: repeat(2, 1fr); gap: 18px; }\n      .hero-content { padding: 28px 20px; }\n      .hero-title { font-size: 2.8rem; }\n      .editorial-panel { flex-direction: column; }\n      .cart-dialog { width: 100%; }\n    }\n\n    @media (max-width: 480px) {\n      .product-grid { grid-template-columns: 1fr; }\n      .main-nav { gap: 12px; }\n      .search-box { flex-basis: 100%; order: 5; }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      *, *::before, *::after {\n        animation-duration: 0.01ms !important;\n        transition-duration: 0.01ms !important;\n      }\n    }\n\n    /* inline svg */\n    svg.icon {\n      width: 18px;\n      height: 18px;\n      stroke: currentColor;\n      fill: none;\n      stroke-width: 2;\n      stroke-linecap: round;\n      stroke-linejoin: round;\n    }\n  </style>\n</head>\n<body class=\"dark\">\n  <header class=\"site-header\">\n    <div class=\"container header-wrapper\">\n      <div class=\"logo-area\">\n        <span class=\"logo-dot\" aria-hidden=\"true\"></span>\n        <span>RESPAWN</span>\n      </div>\n      <nav class=\"main-nav\" aria-label=\"Primary\">\n        <a href=\"#\" data-scroll=\"discover\">Discover</a>\n        <a href=\"#\" data-scroll=\"gear\">Gear</a>\n        <a href=\"#\" data-scroll=\"collections\">Collections</a>\n      </nav>\n      <div class=\"search-box\">\n        <svg class=\"icon\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg>\n        <input type=\"search\" id=\"searchInput\" aria-label=\"Search gear\" placeholder=\"Search gear\">\n      </div>\n      <div class=\"icon-buttons\">\n        <button class=\"icon-btn\" id=\"themeToggle\" aria-pressed=\"true\" aria-label=\"Toggle theme\">\n          <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\"><circle cx=\"12\" cy=\"12\" r=\"5\"/><path d=\"M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4\"/></svg>\n          <span>Theme</span>\n        </button>\n        <button class=\"icon-btn\" id=\"savedBtn\" aria-label=\"Saved items\">\n          <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z\"/></svg>\n          <span id=\"savedCount\">0</span>\n        </button>\n        <button class=\"icon-btn\" id=\"loginBtn\" aria-label=\"Demo login\">Demo login</button>\n        <button class=\"icon-btn\" id=\"cartBtn\" aria-label=\"Cart\">\n          <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\"><circle cx=\"9\" cy=\"21\" r=\"1\"/><circle cx=\"20\" cy=\"21\" r=\"1\"/><path d=\"M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6\"/></svg>\n          <span id=\"cartCount\">0</span>\n        </button>\n      </div>\n    </div>\n  </header>\n  <div class=\"status-strip\">\n    <span>THE NEXT LEVEL STARTS HERE</span>\n    <span>LOCAL STOREFRONT DEMO</span>\n  </div>\n\n  <main class=\"container\">\n    <!-- HERO -->\n    <section class=\"hero-section\" id=\"discover\" aria-label=\"Hero\">\n      <div class=\"hero-bg\"></div>\n      <div class=\"hero-gradient\"></div>\n      <div class=\"hero-content\">\n        <span class=\"hero-pill\">THE AFTERHOURS COLLECTION</span>\n        <h1 class=\"hero-title\">Good games.<br>Great gear.</h1>\n        <p class=\"hero-desc\">Premium gaming tools for players who want clarity, precision and style in every session.</p>\n        <button class=\"hero-cta\" id=\"exploreBtn\">Explore the drop</button>\n        <span class=\"hero-small\">Built for your next main quest</span>\n      </div>\n    </section>\n\n    <div class=\"service-strip\">\n      <span>Curated for play</span>\n      <span>Find your next upgrade</span>\n      <span>Demo checkout · no payments</span>\n    </div>\n\n    <!-- PRODUCT SECTION -->\n    <section class=\"product-section\" id=\"gear\">\n      <div class=\"section-head\">\n        <h2>Upgrade your loadout.</h2>\n        <p class=\"section-sub\">Carefully selected controllers, keyboards, audio and mice for every play style.</p>\n      </div>\n      <div class=\"filters-row\">\n        <div class=\"filter-tabs\" role=\"group\" aria-label=\"Filter by category\">\n          <button class=\"filter-tab\" data-filter=\"all\" aria-pressed=\"true\">All gear</button>\n          <button class=\"filter-tab\" data-filter=\"Controllers\" aria-pressed=\"false\">Controllers</button>\n          <button class=\"filter-tab\" data-filter=\"Keyboards\" aria-pressed=\"false\">Keyboards</button>\n          <button class=\"filter-tab\" data-filter=\"Audio\" aria-pressed=\"false\">Audio</button>\n          <button class=\"filter-tab\" data-filter=\"Mice\" aria-pressed=\"false\">Mice</button>\n          <button class=\"filter-tab\" id=\"savedFilterBtn\" data-filter=\"saved\" aria-pressed=\"false\">Saved items only</button>\n        </div>\n        <select class=\"sort-select\" id=\"sortSelect\" aria-label=\"Sort products\">\n          <option value=\"featured\">Featured</option>\n          <option value=\"low\">Price: low to high</option>\n          <option value=\"high\">Price: high to low</option>\n        </select>\n      </div>\n\n      <div id=\"productGrid\" class=\"product-grid\"></div>\n    </section>\n\n    <!-- EDITORIAL COLLECTION -->\n    <section class=\"editorial-panel\" id=\"collections\" aria-label=\"Keyboard collection\">\n      <img src=\"http://127.0.0.1:5173/marketplace/keyboard.webp\" alt=\"Nova 75 Mechanical keyboard with lavender keys\" width=\"380\" height=\"240\" loading=\"lazy\">\n      <div class=\"editorial-copy\">\n        <h3>Less noise. More play.</h3>\n        <p>Experience compact precision with our Nova 75 mechanical line. Lavender keys, clean actuation, zero distractions.</p>\n        <button class=\"shop-btn\" id=\"shopKeyboardsBtn\">Shop keyboards</button>\n      </div>\n    </section>\n  </main>\n\n  <footer class=\"site-footer container\">\n    <div class=\"footer-left\"><span class=\"footer-dot\"></span> RESPAWN</div>\n    <div>\n      <p>Your next level is waiting.</p>\n      <p style=\"color: var(--muted); font-size:0.85rem\">Concept products. Demo storefront. No real transactions.</p>\n    </div>\n  </footer>\n\n  <!-- CART DIALOG -->\n  <div id=\"cartOverlay\" class=\"dialog-overlay\" style=\"display:none;\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Shopping cart\"></div>\n\n  <!-- LOGIN DIALOG -->\n  <div id=\"loginOverlay\" class=\"dialog-overlay\" style=\"display:none; justify-content:center; align-items:center;\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Demo login\">\n    <div class=\"cart-dialog\" style=\"border-radius:18px; max-width:420px;\">\n      <div class=\"dialog-header\"><h3>Demo login</h3><button class=\"close-btn\" id=\"closeLoginBtn\" aria-label=\"Close login\">×</button></div>\n      <label for=\"displayNameInput\">Display name</label>\n      <input type=\"text\" id=\"displayNameInput\" placeholder=\"e.g., PlayerOne\" style=\"padding:12px; border-radius:8px; border:1px solid var(--border); background:var(--surface-2); color:var(--text);\">\n      <button class=\"dialog-main-btn\" id=\"enterDemoBtn\">Enter demo workspace</button>\n    </div>\n  </div>\n\n  <!-- CHECKOUT DIALOG -->\n  <div id=\"checkoutOverlay\" class=\"dialog-overlay\" style=\"display:none; justify-content:center; align-items:center;\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Checkout\">\n    <div class=\"cart-dialog\" style=\"border-radius:18px; max-width:480px;\">\n      <div class=\"dialog-header\"><h3>Demo order</h3><button class=\"close-btn\" id=\"closeCheckoutBtn\" aria-label=\"Close checkout\">×</button></div>\n      <div id=\"checkoutSummary\"></div>\n      <label for=\"checkoutNameInput\">Display name (no private details)</label>\n      <input type=\"text\" id=\"checkoutNameInput\" placeholder=\"Your display name\" style=\"padding:12px; border-radius:8px; border:1px solid var(--border); background:var(--surface-2); color:var(--text);\">\n      <label><input type=\"checkbox\" id=\"demoAgreeCheck\"> I understand this is a demo order</label>\n      <button class=\"dialog-main-btn\" id=\"placeDemoOrderBtn\">Place demo order</button>\n    </div>\n  </div>\n\n  <!-- CONFIRMATION DIALOG -->\n  <div id=\"confirmationOverlay\" class=\"dialog-overlay\" style=\"display:none; justify-content:center; align-items:center;\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Order confirmation\">\n    <div class=\"cart-dialog\" style=\"border-radius:18px; max-width:420px;\">\n      <div class=\"dialog-header\"><h3>Success</h3><button class=\"close-btn\" id=\"closeConfirmationBtn\" aria-label=\"Close confirmation\">×</button></div>\n      <p id=\"confirmationMessage\" style=\"font-weight:700;\"></p>\n      <button class=\"dialog-main-btn\" id=\"continueShoppingBtn\">Continue shopping</button>\n    </div>\n  </div>\n\n  <script>\n    (function() {\n      // PRODUCT DATA\n      const products = [\n        { id: 'p1', name: 'Phantom Wireless', category: 'Controllers', price: 89, desc: 'Transparent shell, responsive controls.', img: 'http://127.0.0.1:5173/marketplace/controller.webp', tag: 'New' },\n        { id: 'p2', name: 'Nova 75 Mechanical', category: 'Keyboards', price: 129, desc: 'Lavender keys, compact precision.', img: 'http://127.0.0.1:5173/marketplace/keyboard.webp', tag: 'Best seller' },\n        { id: 'p3', name: 'Eclipse Spatial', category: 'Audio', price: 109, desc: 'Over-ear comfort, immersive sound.', img: 'http://127.0.0.1:5173/marketplace/headset.webp', tag: 'Spatial' },\n        { id: 'p4', name: 'Drift Ultralight', category: 'Mice', price: 59, desc: 'Lightweight control, coral accents.', img: 'http://127.0.0.1:5173/marketplace/mouse.webp', tag: 'Feather' },\n        { id: 'p5', name: 'Phantom Dawn', category: 'Controllers', price: 94, desc: 'Sunrise colorway, responsive controls.', img: 'http://127.0.0.1:5173/marketplace/controller.webp', tag: 'Limited' },\n        { id: 'p6', name: 'Nova 75 Midnight', category: 'Keyboards', price: 134, desc: 'Dark lavender, compact precision.', img: 'http://127.0.0.1:5173/marketplace/keyboard.webp', tag: 'Stealth' },\n        { id: 'p7', name: 'Eclipse Breeze', category: 'Audio', price: 113, desc: 'Cool gray, immersive sound.', img: 'http://127.0.0.1:5173/marketplace/headset.webp', tag: 'Airy' },\n        { id: 'p8', name: 'Drift Coral Flash', category: 'Mice', price: 62, desc: 'Bright coral, lightweight control.', img: 'http://127.0.0.1:5173/marketplace/mouse.webp', tag: 'Flash' }\n      ];\n\n      let currentFilter = 'all';\n      let sortMode = 'featured';\n      let searchQuery = '';\n      let cart = [];\n      let savedItems = new Set();\n      let loggedInUser = null;\n      let lastFocusedElement = null;\n\n      const body = document.body;\n      const themeToggle = document.getElementById('themeToggle');\n      const savedBtn = document.getElementById('savedBtn');\n      const savedCountSpan = document.getElementById('savedCount');\n      const cartBtn = document.getElementById('cartBtn');\n      const cartCountSpan = document.getElementById('cartCount');\n      const searchInput = document.getElementById('searchInput');\n      const sortSelect = document.getElementById('sortSelect');\n      const productGrid = document.getElementById('productGrid');\n      const filterTabs = document.querySelectorAll('.filter-tab');\n      const savedFilterBtn = document.getElementById('savedFilterBtn');\n\n      // OVERLAYS\n      const cartOverlay = document.getElementById('cartOverlay');\n      const loginOverlay = document.getElementById('loginOverlay');\n      const checkoutOverlay = document.getElementById('checkoutOverlay');\n      const confirmationOverlay = document.getElementById('confirmationOverlay');\n\n      function updateCartBadge() {\n        const total = cart.reduce((sum, item) => sum + item.qty, 0);\n        cartCountSpan.textContent = total;\n      }\n\n      function updateSavedBadge() {\n        savedCountSpan.textContent = savedItems.size;\n        if (savedFilterBtn) savedFilterBtn.setAttribute('aria-pressed', currentFilter === 'saved' ? 'true' : 'false');\n      }\n\n      function renderProducts() {\n        let filtered = products.slice();\n        if (currentFilter === 'saved') {\n          filtered = filtered.filter(p => savedItems.has(p.id));\n        } else if (currentFilter !== 'all') {\n          filtered = filtered.filter(p => p.category === currentFilter);\n        }\n        if (searchQuery.trim()) {\n          const q = searchQuery.toLowerCase();\n          filtered = filtered.filter(p => (p.name.toLowerCase().includes(q) || p.category.toLowerCase().includes(q) || p.desc.toLowerCase().includes(q)));\n        }\n        if (sortMode === 'low') filtered.sort((a,b) => a.price-b.price);\n        else if (sortMode === 'high') filtered.sort((a,b) => b.price-a.price);\n\n        productGrid.innerHTML = '';\n        if (filtered.length === 0) {\n          const empty = document.createElement('div');\n          empty.className = 'empty-state';\n          empty.innerHTML = '<p style=\"font-size:1.4rem; font-weight:700;\">No gear found</p><p>Try adjusting filters or search.</p>';\n          const reset = document.createElement('button');\n          reset.className = 'reset-btn';\n          reset.textContent = 'Reset filters';\n          reset.addEventListener('click', () => {\n            currentFilter = 'all';\n            searchInput.value = '';\n            searchQuery = '';\n            sortSelect.value = 'featured';\n            filterTabs.forEach(tab => tab.setAttribute('aria-pressed', tab.dataset.filter === 'all'));\n            renderProducts();\n          });\n          empty.appendChild(reset);\n          productGrid.appendChild(empty);\n          return;\n        }\n\n        filtered.forEach(product => {\n          const card = document.createElement('div');\n          card.className = 'product-card';\n          card.innerHTML = `\n            <div class=\"card-img\" style=\"background-image:url('${product.img}');\" role=\"img\" aria-label=\"${product.name}\">\n              <span class=\"card-tag\">${product.tag}</span>\n              <button class=\"save-btn\" data-id=\"${product.id}\" aria-pressed=\"${savedItems.has(product.id)}\" aria-label=\"Save ${product.name}\">\n                <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z\"/></svg>\n              </button>\n            </div>\n            <div class=\"card-body\">\n              <span class=\"card-category\">${product.category}</span>\n              <span class=\"card-name\">${product.name}</span>\n              <span class=\"card-desc\">${product.desc}</span>\n              <span class=\"card-price\">$${product.price}</span>\n              <button class=\"add-btn\" data-id=\"${product.id}\">Add to cart</button>\n            </div>\n          `;\n          productGrid.appendChild(card);\n        });\n\n        document.querySelectorAll('.save-btn').forEach(btn => {\n          btn.addEventListener('click', (e) => {\n            const id = btn.dataset.id;\n            if (savedItems.has(id)) savedItems.delete(id);\n            else savedItems.add(id);\n            btn.setAttribute('aria-pressed', savedItems.has(id));\n            updateSavedBadge();\n            if (currentFilter === 'saved') renderProducts();\n          });\n        });\n\n        document.querySelectorAll('.add-btn').forEach(btn => {\n          btn.addEventListener('click', (e) => {\n            const id = btn.dataset.id;\n            const product = products.find(p => p.id === id);\n            if (!product) return;\n            const existing = cart.find(item => item.id === id);\n            if (existing) existing.qty += 1;\n            else cart.push({ ...product, qty: 1 });\n            updateCartBadge();\n          });\n        });\n      }\n\n      function openCart() {\n        lastFocusedElement = document.activeElement;\n        cartOverlay.style.display = 'flex';\n        renderCartItems();\n        cartOverlay.querySelector('.close-btn')?.focus();\n      }\n\n      function renderCartItems() {\n        const overlayContent = cartOverlay;\n        overlayContent.innerHTML = '';\n        const dialog = document.createElement('div');\n        dialog.className = 'cart-dialog';\n        dialog.setAttribute('role', 'document');\n        let totalPrice = 0;\n        dialog.innerHTML = `<div class=\"dialog-header\"><h3>Your Cart</h3><button class=\"close-btn\" id=\"closeCartBtn\" aria-label=\"Close cart\">×</button></div>`;\n        if (cart.length === 0) {\n          dialog.innerHTML += `<p style=\"padding:20px 0;\">Your cart is empty.</p>`;\n        } else {\n          cart.forEach(item => {\n            totalPrice += item.price * item.qty;\n            const itemDiv = document.createElement('div');\n            itemDiv.className = 'cart-item';\n            itemDiv.innerHTML = `<span><strong>${item.name}</strong> ($${item.price})</span>`;\n            const qtyDiv = document.createElement('div');\n            qtyDiv.className = 'qty-controls';\n            const minus = document.createElement('button'); minus.className = 'qty-btn'; minus.textContent = '-';\n            const plus = document.createElement('button'); plus.className = 'qty-btn'; plus.textContent = '+';\n            const qtySpan = document.createElement('span'); qtySpan.textContent = item.qty;\n            minus.addEventListener('click', () => { if (item.qty > 1) { item.qty--; } else { cart = cart.filter(c => c.id !== item.id); } updateCartBadge(); renderCartItems(); });\n            plus.addEventListener('click', () => { item.qty++; updateCartBadge(); renderCartItems(); });\n            qtyDiv.appendChild(minus); qtyDiv.appendChild(qtySpan); qtyDiv.appendChild(plus);\n            const removeBtn = document.createElement('button'); removeBtn.textContent = 'Remove'; removeBtn.style.background='transparent'; removeBtn.style.color='var(--accent-2)'; removeBtn.style.fontWeight='700';\n            removeBtn.addEventListener('click', () => { cart = cart.filter(c => c.id !== item.id); updateCartBadge(); renderCartItems(); });\n            itemDiv.appendChild(qtyDiv); itemDiv.appendChild(removeBtn);\n            dialog.appendChild(itemDiv);\n          });\n          dialog.innerHTML += `<div class=\"cart-total\">Subtotal: $${totalPrice}</div>`;\n          const checkoutBtn = document.createElement('button');\n          checkoutBtn.className = 'checkout-btn';\n          checkoutBtn.textContent = 'Checkout (demo)';\n          checkoutBtn.addEventListener('click', openCheckout);\n          dialog.appendChild(checkoutBtn);\n        }\n        overlayContent.appendChild(dialog);\n        const closeBtn = dialog.querySelector('#closeCartBtn');\n        if (closeBtn) closeBtn.addEventListener('click', closeCart);\n        const firstFocus = dialog.querySelector('button, input');\n        if (firstFocus) firstFocus.focus();\n      }\n\n      function closeCart() {\n        cartOverlay.style.display = 'none';\n        if (lastFocusedElement) lastFocusedElement.focus();\n      }\n\n      function openCheckout() {\n        lastFocusedElement = document.activeElement;\n        checkoutOverlay.style.display = 'flex';\n        const summary = document.getElementById('checkoutSummary');\n        summary.innerHTML = '';\n        if (cart.length === 0) summary.textContent = 'No items in cart.';\n        else {\n          const total = cart.reduce((sum,i)=>sum+i.price*i.qty,0);\n          summary.innerHTML = `<p><strong>Order summary:</strong></p><ul>${cart.map(i=>`<li>${i.name} x${i.qty} = $${i.price*i.qty}</li>`).join('')}</ul><p><strong>Total: $${total}</strong></p>`;\n        }\n        document.getElementById('checkoutNameInput').value = loggedInUser || '';\n        document.getElementById('demoAgreeCheck').checked = false;\n        checkoutOverlay.querySelector('.close-btn')?.focus();\n      }\n\n      function closeCheckout() {\n        checkoutOverlay.style.display = 'none';\n        if (lastFocusedElement) lastFocusedElement.focus();\n      }\n\n      function placeDemoOrder() {\n        const name = document.getElementById('checkoutNameInput').value.trim() || 'Player';\n        const agree = document.getElementById('demoAgreeCheck').checked;\n        if (!agree) { alert('Please confirm demo order.'); return; }\n        const orderNum = Date.now();\n        document.getElementById('confirmationMessage').textContent = `Demo order placed. No payment taken. Order #${orderNum} for ${name}.`;\n        checkoutOverlay.style.display = 'none';\n        confirmationOverlay.style.display = 'flex';\n        cart = [];\n        updateCartBadge();\n        renderCartItems();\n        document.getElementById('continueShoppingBtn').focus();\n      }\n\n      function closeConfirmation() {\n        confirmationOverlay.style.display = 'none';\n        if (lastFocusedElement) lastFocusedElement.focus();\n      }\n\n      function openLogin() {\n        lastFocusedElement = document.activeElement;\n        loginOverlay.style.display = 'flex';\n        document.getElementById('displayNameInput').value = '';\n        loginOverlay.querySelector('#displayNameInput')?.focus();\n      }\n      function closeLogin() {\n        loginOverlay.style.display = 'none';\n        if (lastFocusedElement) lastFocusedElement.focus();\n      }\n\n      document.getElementById('closeLoginBtn')?.addEventListener('click', closeLogin);\n      document.getElementById('enterDemoBtn')?.addEventListener('click', () => {\n        const name = document.getElementById('displayNameInput').value.trim() || 'Player';\n        loggedInUser = name;\n        loginBtn.textContent = `Hi, ${name}`;\n        closeLogin();\n      });\n\n      loginBtn.addEventListener('click', openLogin);\n      cartBtn.addEventListener('click', openCart);\n      savedBtn.addEventListener('click', () => {\n        currentFilter = 'saved';\n        filterTabs.forEach(tab => tab.setAttribute('aria-pressed', 'false'));\n        savedFilterBtn.setAttribute('aria-pressed', 'true');\n        renderProducts();\n      });\n\n      document.getElementById('closeCheckoutBtn')?.addEventListener('click', closeCheckout);\n      document.getElementById('placeDemoOrderBtn')?.addEventListener('click', placeDemoOrder);\n      document.getElementById('closeConfirmationBtn')?.addEventListener('click', closeConfirmation);\n      document.getElementById('continueShoppingBtn')?.addEventListener('click', () => {\n        confirmationOverlay.style.display = 'none';\n      });\n\n      cartOverlay.addEventListener('click', (e) => { if (e.target === cartOverlay) closeCart(); });\n      loginOverlay.addEventListener('click', (e) => { if (e.target === loginOverlay) closeLogin(); });\n      checkoutOverlay.addEventListener('click', (e) => { if (e.target === checkoutOverlay) closeCheckout(); });\n      confirmationOverlay.addEventListener('click', (e) => { if (e.target === confirmationOverlay) closeConfirmation(); });\n\n      themeToggle.addEventListener('click', () => {\n        body.classList.toggle('dark');\n        themeToggle.setAttribute('aria-pressed', body.classList.contains('dark'));\n      });\n\n      searchInput.addEventListener('input', (e) => {\n        searchQuery = e.target.value;\n        renderProducts();\n        searchInput.focus();\n      });\n\n      sortSelect.addEventListener('change', (e) => {\n        sortMode = e.target.value;\n        renderProducts();\n      });\n\n      filterTabs.forEach(tab => {\n        tab.addEventListener('click', () => {\n          currentFilter = tab.dataset.filter;\n          filterTabs.forEach(t => t.setAttribute('aria-pressed', 'false'));\n          tab.setAttribute('aria-pressed', 'true');\n          if (currentFilter === 'saved') savedFilterBtn.setAttribute('aria-pressed', 'true');\n          renderProducts();\n        });\n      });\n\n      document.getElementById('exploreBtn').addEventListener('click', () => document.getElementById('gear').scrollIntoView({behavior:'smooth'}));\n      document.getElementById('shopKeyboardsBtn').addEventListener('click', () => {\n        currentFilter = 'Keyboards';\n        filterTabs.forEach(t => t.setAttribute('aria-pressed', 'false'));\n        document.querySelector('[data-filter=\"Keyboards\"]').setAttribute('aria-pressed', 'true');\n        renderProducts();\n        document.getElementById('gear').scrollIntoView({behavior:'smooth'});\n      });\n\n      document.querySelectorAll('.main-nav a').forEach(a => a.addEventListener('click', (e) => {\n        e.preventDefault();\n        const target = a.dataset.scroll;\n        document.getElementById(target)?.scrollIntoView({behavior:'smooth'});\n      }));\n\n      // initialize\n      renderProducts();\n      updateCartBadge();\n      updateSavedBadge();\n\n      // escape key handling\n      window.addEventListener('keydown', (e) => {\n        if (e.key === 'Escape') {\n          if (confirmationOverlay.style.display === 'flex') closeConfirmation();\n          else if (checkoutOverlay.style.display === 'flex') closeCheckout();\n          else if (loginOverlay.style.display === 'flex') closeLogin();\n          else if (cartOverlay.style.display === 'flex') closeCart();\n        }\n      });\n    })();\n  </script>\n</body>\n</html>",
  "model": "deepseek-v4-pro",
  "provider": "DeepSeek"
}