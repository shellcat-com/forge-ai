# Forge currently consumes no environment variables.
# These non-secret names reserve the intended server configuration contract.
FORGE_HOST=127.0.0.1
FORGE_PORT=3000
FORGE_DATA_DIR=./data
FORGE_WORKSPACE_ROOT=./workspaces
FORGE_LOG_LEVEL=info

# Provider credentials are intentionally omitted until adapters exist.
# Never use a VITE_ prefix for secrets; Vite exposes those values to clients.
