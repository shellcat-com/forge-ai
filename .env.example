# Copy to .env.local. Secrets are read by the API processes; only VITE flags are public.
# Direct DeepSeek is opt-in. Secrets must never use a VITE_ prefix.
FORGE_PROVIDER=nvidia
DEEPSEEK_API_KEY=
NVIDIA_API_KEY=
# Local request budget; NOT a provider entitlement. Resets on server restart.
FORGE_DAILY_REQUEST_LIMIT=100

# Reserved for future server/runtime work. The current app does not use these.
FORGE_DATA_DIR=
FORGE_WORKSPACE_ROOT=

# Cloud account mode. The VITE flag is public; all database credentials are server-only.
VITE_FORGE_AUTH_ENABLED=false
# Optional local engine review UI at #/engine. This grants no authentication or
# execution authority. Its fixed development API proxy is loopback port3002;
# E1 must separately be configured for exact origin http://127.0.0.1:5173.
VITE_FORGE_ENGINE_UI=false
FORGE_AUTH_ENABLED=false
FORGE_APP_ORIGIN=http://127.0.0.1:5173
NEON_AUTH_BASE_URL=
# Comma-separated Google/GitHub methods configured and verified in Neon. Empty = email only.
FORGE_AUTH_SOCIAL_PROVIDERS=
DATABASE_URL=
DATABASE_MIGRATION_URL=
# Server-only project-scoped Neon key for self-service account deletion.
# Apply migration 0002 so the runtime can check session freshness.
FORGE_NEON_ADMIN_KEY=
FORGE_NEON_PROJECT_ID=
FORGE_NEON_BRANCH_ID=
# Hosted text planning is independently opt-in; never enable the legacy loopback API publicly.
FORGE_HOSTED_PLANNING_ENABLED=false
FORGE_HOSTED_PLANNING_DAILY_LIMIT=20

# Optional account-owned provider connections. Server only: 32 random bytes as 64 hex characters.
# Apply cloud migrations before enabling. Back up separately from the database.
FORGE_PROVIDER_ENCRYPTION_KEY=

# Server-only: 32+ random characters for managed same-origin auth cookies.
NEON_AUTH_COOKIE_SECRET=
