# Enter secrets directly in ignored .env.local, never in chat or NEXT_PUBLIC_* variables.
GEMINI_API_KEY=
# Discover models in Forge, then select one verified as free for your project.
GEMINI_MODEL=
GEMINI_FREE_TIER_CONFIRMED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
# OpenRouter is optional. Select one exact model to prevent arbitrary paid use.
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_API_KEY=
OPENROUTER_PAID_MODEL_CONFIRMED=false
# Optional Groq provider. Forge allows only this exact configured model.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=

# Optional loopback-only text planning
NVIDIA_API_KEY=
FORGE_DAILY_REQUEST_LIMIT=100

# Application persistence. Never expose these to the client.
DATABASE_URL=
DATABASE_DIRECT_URL=
FORGE_AUTH_MODE=local
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_API_KEY=

# Optional verified auth providers. Leave unconfigured methods blank.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# HTTPS transactional email endpoint accepting {to, subject, url}.
FORGE_EMAIL_ENDPOINT=
FORGE_EMAIL_TOKEN=
# Local identity and isolated development ports.
FORGE_LOCAL_OWNER_ID=local-owner
FORGE_PREVIEW_PORT=3101
FORGE_RUNTIME_IMAGE=forge-workspace:local

# User-owned model connections. Never expose these through NEXT_PUBLIC_*.
# Generate a separate random 32-byte hex wrapping key, then set a versioned JSON keyring.
# FORGE_BYOK_ACTIVE_KEY=v1
# FORGE_BYOK_KEYRING={"v1":"<64 lowercase hex characters>"}
# Optional exact private API bases for self-hosted installations only (comma-separated).
# FORGE_BYOK_PRIVATE_BASE_URLS=http://127.0.0.1:1234/v1/
# Owner-wide maximum simultaneous model requests (1-8; default 1).
# FORGE_BYOK_CONCURRENCY=1
# Per-connection maximum simultaneous requests (1-8; default 1).
# FORGE_BYOK_CONNECTION_CONCURRENCY=1
# Current server-reviewed pricing and billable input ceilings; see docs/byok-orchestration.md.
# FORGE_BYOK_PRICES=[]
# Enable only in the isolated internal test environment. Durable shared cap: $10 total.
# FORGE_BYOK_TEST_BUDGET_MICROS=10000000
# Installed application PostgreSQL image (resolved to an immutable ID before execution).
# FORGE_APP_POSTGRES_IMAGE=postgres:18-bookworm
