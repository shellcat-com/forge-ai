{
  "name": "forge-scheduler",
  "main": "index.mjs",
  "tsconfig": "tsconfig.json",
  "compatibility_date": "2026-09-10",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": { "FORGE_SCHEDULER_ENABLED": "false" },
  "workflows": [
    { "name": "forge-dispatch", "binding": "FORGE_DISPATCH", "class_name": "ForgeDispatch" },
  ],
}
