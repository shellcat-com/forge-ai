{
  "name": "forge-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Pre-alpha workspace shell for a self-hostable full-stack app generator.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "api": "node --env-file-if-exists=.env.local server/index.mjs",
    "skills:sync": "node scripts/sync-skills.mjs",
    "art:prepare": "node scripts/prepare-art.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "fflate": "^0.8.3"
  }
}
