{
  "name": "forge-ai",
  "version": "0.2.0",
  "private": true,
  "description": "Local-first AI application generation workspace.",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "node --env-file-if-exists=.env.local scripts/start.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "setup:local": "node scripts/setup-local.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "runtime:build": "docker build -f runtime/Dockerfile -t forge-workspace:local .",
    "test:runtime": "tsx scripts/test-runtime.ts",
    "worker": "node --env-file-if-exists=.env.local --import tsx worker/index.ts",
    "predev": "node scripts/copy-editor.mjs",
    "prebuild": "node scripts/copy-editor.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "esbuild": "0.28.2",
    "eslint": "^9.35.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "drizzle-orm": "^0.45.2",
    "monaco-editor": "^0.56.0",
    "next": "^16.3.4",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "overrides": {
    "dompurify": "3.4.15"
  }
}
