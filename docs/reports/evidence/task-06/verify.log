	    OUT alias text,
	    OUT description text,
	    OUT token text,
	    OUT dictionaries regdictionary[],
	    OUT dictionary regdictionary,
	    OUT lexemes text[])
	 RETURNS SETOF record
	 LANGUAGE sql
	 STABLE PARALLEL SAFE STRICT
	BEGIN ATOMIC
	select
	    tt.alias AS alias,
	    tt.description AS description,
