	            ORDER BY m.mapseqno )
	    AS dictionaries,
	    ( SELECT mapdict::regdictionary
	      FROM pg_ts_config_map AS m
	      WHERE m.mapcfg = $1 AND m.maptokentype = parse.tokid
	      ORDER BY ts_lexize(mapdict, parse.token) IS NULL, m.mapseqno
	      LIMIT 1
	    ) AS dictionary,
	    ( SELECT ts_lexize(mapdict, parse.token)
